# =============================================================
# Vorlage für die .env von docker compose
# Kopieren:  cp .env.example .env   und ein starkes Passwort eintragen.
#
# Erzeugen:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# =============================================================

POSTGRES_PASSWORD=

# -- Grafana -> Gruppe 1 (nur fuer die punktuelle Pruefung ihrer DB) --
# Herkunft und Hintergrund: docs/grafana-gruppe1-verbindung.md
GRUPPE1_NETWORK=
GRUPPE1_POSTGRES_HOST=
GRUPPE1_POSTGRES_PORT=5432
GRUPPE1_POSTGRES_DB=ohb_sensordata
GRUPPE1_POSTGRES_USER=
GRUPPE1_POSTGRES_PASSWORD=
