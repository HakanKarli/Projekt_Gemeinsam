# =============================================================
# OHB Edge-Agent — Konfiguration
#
# Kopieren nach /etc/ohb-edge/agent.env und ausfüllen.
# Die systemd-Unit liest die Datei über EnvironmentFile.
# =============================================================

# ── Identität dieses Messpunkts ─────────────────────────────
# ACHTUNG: Die UUID bildet zusammen mit Messgröße und Zeitstempel den Schlüssel,
# über den der Server Wiederholungen erkennt. Sie darf sich NIEMALS ändern —
# sonst entsteht serverseitig ein neuer Sensor ohne Zuordnung und Schwellenwerte.
# Erzeugen:  python3 -c "import uuid; print(uuid.uuid4())"
OHB_SENSOR_UUID=
OHB_SENSOR_NAME=Reinraum 221 Eingang
OHB_GATEWAY_ID=gw-reinraum-221
# 0 = zyklisch, 1 = ereignisgesteuert
OHB_EVENT_DRIVEN=0

# ── Datenquelle ─────────────────────────────────────────────
# demo | gpio | serial | upstream_mqtt   (siehe ohb_edge/sensors.py)
OHB_SOURCE=demo

# ── MQTT ────────────────────────────────────────────────────
OHB_BROKER_HOST=192.168.1.10
OHB_BROKER_PORT=1883
# Leer lassen, solange der Broker anonym arbeitet
OHB_BROKER_USERNAME=
OHB_BROKER_PASSWORD=
# Muss je Pi EINDEUTIG sein. Ohne Angabe aus der UUID abgeleitet.
# Zwei Clients mit derselben Kennung werfen sich dauerhaft gegenseitig aus der Verbindung.
OHB_CLIENT_ID=
OHB_KEEPALIVE_S=30
OHB_PUBLISH_TIMEOUT_S=10

# ── Messtakt ────────────────────────────────────────────────
OHB_INTERVAL_S=2.0

# ── Puffer ──────────────────────────────────────────────────
OHB_BUFFER_PATH=/var/lib/ohb-edge/outbox.sqlite3
# Obergrenze. 100.000 Einträge entsprechen bei 2-Sekunden-Takt rund 2,3 Tagen.
# Danach werden die ÄLTESTEN verworfen, damit das Dateisystem nicht vollläuft.
OHB_BUFFER_MAX_ENTRIES=100000
# Nachrichten je Zyklus beim Aufholen nach einem Ausfall
OHB_FLUSH_BATCH_SIZE=200

# ── Uhrzeit ─────────────────────────────────────────────────
# true  = ohne NTP-Synchronität wird gepuffert statt gesendet (Pi OHNE RTC)
# false = der Systemzeit wird vertraut (Pi MIT RTC-Modul, z.B. DS3231)
OHB_REQUIRE_CLOCK_SYNC=true
OHB_CLOCK_RECHECK_S=30

# ── Betrieb ─────────────────────────────────────────────────
OHB_LOG_LEVEL=INFO
# Optional: Zustandsdatei für externe Überwachung
OHB_STATUS_FILE=/run/ohb-edge/status.json
